NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ANTHROPIC_API_KEY=

# EGGIM labeling app: absolute path on the VM holding
#   <LABEL_DATA_DIR>/images/<patient>/<file>.jpg   (resized labeling set)
#   <LABEL_DATA_DIR>/labels/<expertId>.json        (written by the app)
LABEL_DATA_DIR=/data/eggim
# Shared access password for the labeling app (HTTP Basic Auth). Default: 2044
LABEL_PASSWORD=2044
# PI identifier who can view the inter-rater agreement (kappa) page. Default: kdh
LABEL_PI_ID=kdh
